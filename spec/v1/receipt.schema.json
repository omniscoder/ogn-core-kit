{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/omniscoder/ogn-core-kit/spec/v1/receipt.schema.json",
  "title": "OGN Receipt v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run_id",
    "tenant_id",
    "created_at",
    "engine",
    "inputs",
    "outputs",
    "artifacts",
    "hashes",
    "verification"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ogn.receipt.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "engine": {
      "type": "object",
      "required": ["profile", "requested_version"],
      "additionalProperties": true
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "additionalProperties": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "media_type": { "type": "string" },
          "optional": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "hashes": {
      "type": "object",
      "required": ["receipt_payload_sha256"],
      "additionalProperties": true
    },
    "signature": {
      "type": "object",
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["unsigned", "signed", "verified"] }
      },
      "additionalProperties": true
    }
  }
}
